# OPTIONAL. docker-compose.yml has a working local default for every value here, so a
# fresh clone runs with no .env at all. Copy this to .env only to override them.
# Never commit the real .env.
# n8n stores its workflows in Postgres, so these credentials must stay stable
# across restarts or n8n will not find its existing data.

N8N_VERSION=stable

# n8n's own Postgres (separate from Jarvis's retrieval database).
N8N_POSTGRES_USER=
N8N_POSTGRES_PASSWORD=
N8N_POSTGRES_DB=
N8N_POSTGRES_NON_ROOT_USER=
N8N_POSTGRES_NON_ROOT_PASSWORD=

N8N_RUNNERS_AUTH_TOKEN=
