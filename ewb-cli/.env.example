# ─── Consumer app (this is the only var the components read) ──────────────────
# Base URL of YOUR retrieval-search backend deployment.
NEXT_PUBLIC_EWB_API_URL=http://localhost:8080/api/v1

# ─── Your backend deployment (NOT read by the components) ─────────────────────
# The browser never talks to Ollama or Postgres — the Spring backend does.
# Set these on the backend you point NEXT_PUBLIC_EWB_API_URL at.
#
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=retrieval_search
# DB_USER=retrieval
# DB_PASSWORD=retrieval
# CORS_ALLOWED_ORIGINS=http://localhost:3000
