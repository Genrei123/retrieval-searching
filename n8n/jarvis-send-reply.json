        624,
        16
      ],
      "parameters": {
        "jsCode": "// Turns whatever the Gmail node produced into a small, always-200 result the homepage can\n// read. The Gmail node is set to continue on error, so a rejected send arrives here as an\n// item carrying `error` rather than as a failed execution -- and a failed execution would\n// skip \"Respond to Sender\", stripping the CORS header and leaving the browser with an\n// opaque network error instead of a reason.\nconst r = $json ?? {};\n\n// A successful reply comes back as the sent Gmail message resource, which always has an id.\nconst sent = Boolean(r.id) && !r.error;\n\nconst reason = (e) => {\n  if (!e) return 'Gmail did not confirm the reply was sent.';\n  if (typeof e === 'string') return e;\n  return String(e.message ?? e.description ?? JSON.stringify(e));\n};\n\nreturn [{ json: {\n  sent,\n  message_id: sent ? String(r.id) : null,\n  thread_id: sent ? String(r.threadId ?? '') : null,\n  error: sent ? null : reason(r.error),\n} }];\n"
      }
    },
    {
      "id": "4e8b0c27-5d1f-49a3-b672-8c0e37f1a95d",
      "name": "Respond to Sender",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        832,
        16
      ],
      "parameters": {
        "respondWith": "firstIncomingItem",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "http://localhost:3000"
              }
            ]
          }
        }
      }
    }
