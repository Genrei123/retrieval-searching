# --- Backend API ---------------------------------------------------------
# Base URL of the retrieval-search Spring Boot API (see
# ../rag-document-search/src/main/resources/application.yaml).
# Read on the client, so it must be prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# --- Morning briefing ------------------------------------------------------
# Production webhook of the "Jarvis Homepage Briefing" n8n workflow (../n8n/).
# Read on the client, so it must be reachable from the browser, not from inside
# the compose network.
NEXT_PUBLIC_N8N_BRIEFING_URL=http://localhost:5678/webhook/jarvis-briefing

# Production webhook of the "Jarvis Send Reply" workflow, which the homepage POSTs to
# when you reply to one of the emails on the "Needs a reply" card.
NEXT_PUBLIC_N8N_REPLY_URL=http://localhost:5678/webhook/jarvis-reply
